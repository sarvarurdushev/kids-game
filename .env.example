# Postgres connection used by the app at runtime (Supabase pooled connection,
# port 6543, transaction mode). Example Supabase pooled URL:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kids_game"

# Direct (non-pooled) connection, used only by drizzle-kit for migrations.
# Supabase direct connection is on port 5432.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kids_game"

# Secret used to sign the gk_family (device enrollment) and gk_session (login)
# JWT cookies. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Shared secret used by /api/dev/simulate-event locally. Never set this in
# production — the route refuses to run outside development.
DEV_WEBHOOK_SECRET="dev-secret-change-me"
